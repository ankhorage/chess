{
  "name": "@ankhorage/chess",
  "version": "0.0.0",
  "description": "Framework-independent, headless rules engine for configurable chess.",
  "license": "MIT",
  "homepage": "https://github.com/ankhorage/chess#readme",
  "bugs": {
    "url": "https://github.com/ankhorage/chess/issues"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ankhorage/chess.git"
  },
  "keywords": [
    "ankhorage",
    "chess",
    "typescript",
    "rules-engine"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "README.md",
    "CHANGELOG.md",
    "LICENSE",
    "paradox"
  ],
  "scripts": {
    "build": "rm -rf dist tsconfig.tsbuildinfo tsconfig.build.tsbuildinfo && bun x tsc -p tsconfig.build.json",
    "check-types": "bun run typecheck",
    "docs": "bunx @ankhorage/paradox && ankhorage-prettier --write README.md paradox",
    "lint": "ankhorage-eslint . --max-warnings=0",
    "lint:fix": "ankhorage-eslint . --fix --max-warnings=0",
    "format": "ankhorage-prettier --write .",
    "format:check": "ankhorage-prettier --check .",
    "knip:check": "ankhorage-knip",
    "prepack": "bun run build",
    "test": "bun test",
    "typecheck": "bun x tsc --noEmit -p tsconfig.json",
    "changeset": "ankhorage-changeset",
    "changeset:status": "ankhorage-changeset status --since=origin/main",
    "version-packages": "ankhorage-changeset version"
  },
  "devDependencies": {
    "@ankhorage/devtools": "^2.4.1",
    "@ankhorage/paradox": "^0.3.6",
    "@types/bun": "^1.4.2",
    "@types/node": "^26.6.6",
    "typescript": "~6.0.3"
  },
  "sideEffects": false,
  "packageManager": "bun@1.4.2",
  "publishConfig": {
    "access": "public"
  }
}
